      "description": "초보자용 기본 근력 향상 프로그램",
      "condition": {
        "and": [
          {"==": [{"var": "survey.experience_level"}, "beginner"]},
          {"includes": [{"var": "survey.goals"}, "strength"]}
        ]
      },
      "result": {
        "planId": "beginner-strength-plan",
        "emailTemplateId": "beginner-welcome",
        "programType": "strength-basic",
        "duration": "12-weeks",
        "frequency": "3-days-week",
        "exercises": [
          "스쿼트",
          "벤치프레스", 
          "데드리프트",
          "오버헤드프레스"
        ],
        "progression": "linear",
        "startingIntensity": 60,
        "recommendations": [
          "기초 동작 숙련에 집중하세요",
          "충분한 휴식을 취하세요",
          "점진적으로 중량을 늘려나가세요"
        ]
      },
      "priority": 100,
      "enabled": true,
      "tags": ["beginner", "strength", "basic"]
